# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=                                    # PostgreSQL (Supabase) connection string (required)

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=                                      # HS256 signing key, min 32 characters (required)
JWT_EXPIRY_HOURS=24                              # Legacy JWT expiry in hours (unused with refresh tokens)
ACCESS_TOKEN_EXPIRY_MINUTES=60                   # Access token lifetime in minutes
REFRESH_TOKEN_EXPIRY_DAYS=7                      # Refresh token rotation window in days

# ── AI Provider (NVIDIA NIM — DeepSeek V4 Flash) ──────────────────────────
# Any OpenAI-compatible chat/completions endpoint works. The generic AI_*
# variables take priority; NVIDIA_* are legacy fallbacks. Set only the ones
# you need — e.g. to plug in a different provider token, set AI_API_KEY.
ENRICHMENT_PROVIDER=nvidia                       # Must be "nvidia" (only supported provider)
AI_API_KEY=                                      # AI API key (preferred — any OpenAI-compatible token)
AI_MODEL=deepseek-ai/deepseek-v4-flash           # Model name (e.g. z-ai/glm-5.2, nvidia/nemotron-3-ultra-550b)
AI_BASE_URL=https://integrate.api.nvidia.com/v1  # OpenAI-compatible base URL
AI_MAX_TOKENS=8192                               # Max output tokens (e.g. 16384 for z-ai/glm-5.2)
AI_TEMPERATURE=0.7                               # Sampling temperature 0–2 (0.2 for consistent code analysis)
AI_JSON_MODE=false                               # Send response_format=json_object when the model supports it
NVIDIA_API_KEY=                                  # [legacy alias] fallback for AI_API_KEY
NVIDIA_MODEL=                                    # [legacy alias] fallback for AI_MODEL
NVIDIA_BASE_URL=                                 # [legacy alias] fallback for AI_BASE_URL

# ── Execution ─────────────────────────────────────────────────────────────
EXECUTOR_MAX_CONCURRENCY=6                       # Max concurrent code executions (semaphore)
EXECUTOR_TIMEOUT_SECONDS=30                      # Per-execution timeout in seconds
DOCKER_IMAGE=golang:1.26-alpine                  # Docker image for Go sandbox
SANDBOX_BASE_DIR=/tmp/koder                      # Temp directory for sandbox files
BUILD_CACHE_DIR=/tmp/go-build-cache              # Go build cache directory

# ── Sandbox (Empty = local Docker) ────────────────────────────────────────
SANDBOX_URL=                                     # Remote sandbox endpoint (Azure Container Apps, set in production)
PYTHON_SANDBOX_URL=                              # Separate sandbox URL for Python (optional)
SANDBOX_RATE_LIMIT_PER_MIN=10                    # Sandbox per-IP rate limit (60 behind a single backend IP)
SANDBOX_REQUEST_TIMEOUT_EXTRA_SECONDS=20         # HTTP wait allowance beyond the execution timeout for occasional sandbox replica churn/outages

# ── Go Version ────────────────────────────────────────────────────────────
GO_VERSION=1.26                                  # Go version directive in generated go.mod

# ── Python Execution ──────────────────────────────────────────────────────
PYTHON_DOCKER_IMAGE=python:3.12-slim             # Docker image for Python sandbox
PYTHON_EXECUTOR_TIMEOUT_SECONDS=60               # Per-Python-execution timeout in seconds

# ── Server ────────────────────────────────────────────────────────────────
PORT=8080                                        # HTTP server port (1–65535)
ENVIRONMENT=development                          # "development" or "production"

# ── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                                # Google OAuth client ID (required for Google Sign-In)

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=                                  # Resend.com API key for transactional emails
EMAIL_FROM=Koder <noreply@koder.sbs>            # Verified sender address in Resend
RESEND_WEBHOOK_SECRET=                           # Svix signing secret from the Resend webhook (whsec_...); enables delivery tracking

# ── Frontend ──────────────────────────────────────────────────────────────
FRONTEND_URL=                                    # Frontend URL for password reset links (required in production)

# ── CORS — MUST be set in production ──────────────────────────────────────
# ALLOWED_ORIGINS (plural) preferred; ALLOWED_ORIGIN (singular) legacy fallback
ALLOWED_ORIGINS=                                 # Comma-separated list of allowed origins
# ALLOWED_ORIGIN=                                # Legacy single-origin (use ALLOWED_ORIGINS instead)

# ── Admin ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=                                     # Admin account email (created on first startup)
ADMIN_PASSWORD=                                  # Admin account password

# ── Build Info (set via -ldflags at build time) ───────────────────────────
BUILD_COMMIT=dev
BUILD_TIME=unknown
